# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# رابط الموقع الرسمي (لروابط الكشوفات في تليجرام)
NEXT_PUBLIC_SITE_URL=https://ashtrakat-almaa.vercel.app

# ——— تليجرام: قاعدة بيانات صور الكشوفات ———
# 1) أنشئ بوت من @BotFather وانسخ التوكن
TELEGRAM_BOT_TOKEN=

# 2) أنشئ قناة، أضف البوت كـ Admin مع صلاحية Post Messages
#    ضع @اسم_القناة أو الرقم مثل -100xxxxxxxxxx
TELEGRAM_CHANNEL_ID=

# 3) رابط القناة للعرض (اختياري)
TELEGRAM_CHANNEL_LINK=https://t.me/

# 4) رقم حسابك الشخصي في تليجرام (المسؤول الوحيد عن البوت)
#    احصل عليه من @userinfobot
TELEGRAM_ADMIN_ID=
